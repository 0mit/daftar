#!/bin/sh
# daftar pre-commit gate. VERSIONED here because .git/hooks is not cloned — install with
#   python3 bin/install.py        (or: sh bin/install.sh, which hands over to it)
# THE GATE OF THE LAW THE GARDEN RUNS: `bin/check.py --staged` reads the pin the INDEX holds (GARDEN.md's `extends`)
# and runs the core's gate (`core/check.py --staged`), which reads the STAGED blobs, not the working tree, so what is
# checked is what is committed: the index is copied into a temporary directory and judged there, with the law it
# stages. A fix left unstaged is not in the commit, and a refusal names each file the working tree holds otherwise.
# A failing write cannot be committed by any model or session; that is what makes the gate law rather
# than advice. To override in a genuine emergency: git commit --no-verify, and say so in the journal.
# ON A CLEAN COMMIT THIS PRINTS ONE LINE, the gate's verdict, because whatever a hook prints stays in an agent's
# context for the rest of its session.
root=$(git rev-parse --show-toplevel)
# WHICH PYTHON: the first that runs AND imports yaml, recorded per clone as `git config daftar.python`. python.sh
# says why and is installed beside this hook, so the hook does not depend on what the working tree holds.
_here=$(dirname "$0")
[ -f "$_here/python.sh" ] || { echo "daftar hook: $_here/python.sh is missing — run: python3 bin/install.py" >&2; exit 1; }
. "$_here/python.sh"
daftar_choose_python || exit 1
# The GATE (the law), over the index. A release's corpus tests are deliberately NOT here — a hook that slow invites --no-verify, which
# is the failure mode a hook must avoid, and it let a failing test through on 2026-08-02.
daftar_py "$root/bin/check.py" --staged || exit 1
# MATERIAL SEALED HERE IS HERE (24.0, N30): every pointer the commit adds resolves in a store on this host. The gate
# never reads a store — it judges alike on every copy and in CI — so the hook, which runs on the host, asks bin/held.py
# (a sealed statement: v1 part 8).
# Silent when nothing is added or all of it resolves.
daftar_py "$root/bin/held.py" new --staged
